<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Color_Background"
    android:fillViewport="true"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.example.android.cricketscoreboard.views.ScorerPadActivity"
    tools:showIn="@layout/app_bar_scorer_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/score_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rectangle">

            <!-- Scoreboard Header Banner -->
            <LinearLayout
                android:id="@+id/scoreboard_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_scoreboard_header"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/Batting_score_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCORE  "
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Batting_score_editText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:text="0"
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Slash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="/"
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/Wickets_editText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:text="0"
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Bowling_overs_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OVERS  "
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Bowling_overs_editText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:text="0"
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Bowling_oversBall_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="."
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Bowling_oversBall_editText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:text="0"
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/thisOver_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Over: "
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/thisOverValue_text_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:hint="—"
                        android:text=""
                        android:textColor="@color/colorOnSurfaceHeader"
                        android:textColorHint="@color/colorOnSurfaceHeader"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bowler Selection Row -->
            <TextView
                android:id="@+id/bowlerName_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/scoreboard_banner"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="Bowler:"
                android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

            <Spinner
                android:id="@+id/bowlerName_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/bowlerName_text_view"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:layout_toStartOf="@+id/StartOver_btn"
                android:layout_toLeftOf="@+id/StartOver_btn"
                android:layout_toEndOf="@id/bowlerName_text_view"
                android:layout_toRightOf="@id/bowlerName_text_view"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/StartOver_btn"
                style="@style/Widget.Cricket.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/bowlerName_text_view"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:text="Set Bowler" />

            <!-- Runs Scored Section -->
            <TextView
                android:id="@+id/scoredRuns_textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/bowlerName_text_view"
                android:layout_marginTop="12dp"
                android:text="Runs Scored on Delivery"
                android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

            <RadioGroup
                android:id="@+id/runsScored_radioGrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/scoredRuns_textView"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_stat_chip"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioBtn_ZeroRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="0"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_OneRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="1"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_TwoRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="2"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_ThreeRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="3"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_FourRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="4"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_FiveRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="5"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioBtn_SixRun"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="6"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Extras: Wide / No Ball / Free Hit -->
            <RadioGroup
                android:id="@+id/wideBall_NoBall_radioGrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/runsScored_radioGrp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioBtn_WideBall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_marginRight="12dp"
                    android:minHeight="48dp"
                    android:onClick="onWideBallCheck"
                    android:text="Wide Ball"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioBtn_NoBall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_marginRight="12dp"
                    android:minHeight="48dp"
                    android:onClick="onNoBallCheck"
                    android:text="No Ball"
                    android:textSize="14sp" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/freeHit_checkBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/wideBall_NoBall_radioGrp"
                android:layout_toEndOf="@id/wideBall_NoBall_radioGrp"
                android:layout_toRightOf="@id/wideBall_NoBall_radioGrp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="Free Hit"
                android:textSize="14sp" />

            <!-- Byes / Leg Byes -->
            <RadioGroup
                android:id="@+id/byes_radioGrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/wideBall_NoBall_radioGrp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioBtn_byes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginRight="16dp"
                    android:minHeight="48dp"
                    android:text="Byes"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radioBtn_LegByes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Leg Byes"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Wicket & Undo Controls -->
            <CheckBox
                android:id="@+id/out_CheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/byes_radioGrp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:minHeight="48dp"
                android:onClick="onOutCheckBoxChecked"
                android:text="Out (Wicket)"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/out_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/out_CheckBox"
                android:layout_toEndOf="@id/out_CheckBox"
                android:layout_toRightOf="@id/out_CheckBox"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/undo_checkBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/out_CheckBox"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:minHeight="48dp"
                android:text="UNDO BALL"
                android:textColor="@color/colorDanger"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Primary Ball Record Trigger -->
            <ImageButton
                android:id="@+id/postBall_imageButton"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_below="@id/out_CheckBox"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Record or undo delivery"
                android:onClick="onBallPress"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/as_1409_512" />

            <TextView
                android:id="@+id/recordBall_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/postBall_imageButton"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Tap Cricket Ball to Record Delivery"
                android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

        </RelativeLayout>

        <!-- Current Crease / Batsmen Card -->
        <LinearLayout
            android:id="@+id/batsmen_Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rectangle"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="At the Crease"
                android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

            <RadioGroup
                android:id="@+id/Striker_NonStriker_radioGrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/radioBtn_Striker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Batsmen (Striker)" />

                <RadioButton
                    android:id="@+id/radioBtn_NonStriker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Non Striker" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_stat_chip"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/strikerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Striker ★"
                        android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                    <TextView
                        android:id="@+id/strikerNameValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Opening Batsman 1"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nonStrikerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Non-Striker"
                        android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                    <TextView
                        android:id="@+id/nonStrikerNameValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Opening Batsman 2"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/matchStatusSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Standard T20 (20 Overs) • Innings 1 • PROVISIONAL"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_select_rules_profile"
                    style="@style/Widget.Cricket.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Rules Profile"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_next_innings_or_confirm"
                    style="@style/Widget.Cricket.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="End Innings / Confirm"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_open_match_center"
                    style="@style/Widget.Cricket.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Scorecard &amp; Charts"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_share_live_score"
                    style="@style/Widget.Cricket.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Share Score"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
