<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="20dp"
    android:paddingTop="12dp"
    android:paddingRight="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Summary Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_chip"
            android:orientation="vertical"
            android:padding="@dimen/space_md">

            <TextView
                android:id="@+id/sync_backend_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backend: Local SQLite (Offline Source of Truth)"
                android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

            <TextView
                android:id="@+id/sync_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Status: Offline Only (Local)"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sync_pending_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pending Local Changes: 0"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sync_last_time_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Last Synced: Never"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/switch_sync_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Enable Optional Cloud Synchronization"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Club Workspace ID"
            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

        <EditText
            android:id="@+id/edit_sync_club_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="e.g., royal_cricket_club"
            android:inputType="text"
            android:lines="1"
            android:minHeight="48dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_switch_club"
            style="@style/Widget.Cricket.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Apply / Switch Club Workspace" />

        <Button
            android:id="@+id/btn_sync_now"
            style="@style/Widget.Cricket.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sync Now" />

        <Button
            android:id="@+id/btn_restore_backup"
            style="@style/Widget.Cricket.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Restore Pre-Sync Local Backup" />

    </LinearLayout>
</ScrollView>
