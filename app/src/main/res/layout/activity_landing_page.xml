<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_landing_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Color_Background"
    android:fillViewport="true"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.example.android.cricketscoreboard.views.LandingPageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Club Overview Banner -->
        <LinearLayout
            android:id="@+id/dashboard_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_scoreboard_header"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Club &amp; Match Hub"
                android:textColor="@color/colorOnSurfaceHeader"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashboard_summary_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select a card below to create or manage records"
                android:textColor="@color/colorOnSurfaceHeader"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Action: Start Live Match -->
        <Button
            android:id="@+id/startMatch_btn"
            style="@style/Widget.Cricket.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:drawableTop="@drawable/finish_flag_2"
            android:drawablePadding="4dp"
            android:minHeight="88dp"
            android:onClick="startMatch"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/start_match_string"
            android:textColor="@color/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="Club Management"
            android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

        <!-- Row 1: Team Details & Player Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:orientation="horizontal">

            <Button
                android:id="@+id/teamDetails_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/conference_2"
                android:drawablePadding="8dp"
                android:onClick="teamDetails"
                android:text="@string/team_details_string" />

            <Button
                android:id="@+id/playerDetails_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/user_male_circle_2"
                android:drawablePadding="8dp"
                android:text="@string/player_details_string" />
        </LinearLayout>

        <!-- Row 2: Ground Details & Schedule Matches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/groundDetails_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/geo_fence_2"
                android:drawablePadding="8dp"
                android:onClick="groundDetails"
                android:text="@string/ground_details_string" />

            <Button
                android:id="@+id/scheduleMatch_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/overtime_2"
                android:drawablePadding="8dp"
                android:onClick="scheduleMatches"
                android:text="@string/schedule_match_string" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="Analysis &amp; Configuration"
            android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

        <!-- Row 3: Match Summary & Set Rules -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/viewMatchSummary_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/match_summary"
                android:drawablePadding="8dp"
                android:text="@string/viewMatchSummary_string" />

            <Button
                android:id="@+id/setRules_btn"
                style="@style/Widget.Cricket.DashboardTile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/checklist"
                android:drawablePadding="8dp"
                android:text="@string/set_rules_string" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
