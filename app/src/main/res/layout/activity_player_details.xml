<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_player_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Color_Background"
    android:fillViewport="true"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.example.android.cricketscoreboard.views.PlayerDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/playerDetails_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Player Details"
            android:textAppearance="@style/TextAppearance.Cricket.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Register a player and select their primary roles on the pitch."
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <!-- Player Avatar & Photo Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_stat_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <ImageView
                android:id="@+id/player_img"
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:background="@drawable/user_male_circle_2"
                android:contentDescription="Player avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_marginLeft="@dimen/space_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerImage_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player Avatar"
                    android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/browse_playerPic_btn"
                        style="@style/Widget.Cricket.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginRight="6dp"
                        android:layout_weight="1"
                        android:text="Browse" />

                    <Button
                        android:id="@+id/default_playerPic_btn"
                        style="@style/Widget.Cricket.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Default" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Player Name -->
        <TextView
            android:id="@+id/playerName_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Player Name *"
            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

        <EditText
            android:id="@+id/playerName_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="name"
            android:hapticFeedbackEnabled="true"
            android:hint="Enter full name"
            android:inputType="textPersonName|textCapWords"
            android:lines="1"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <!-- Player's Team Name Search -->
        <TextView
            android:id="@+id/playerTeamName_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Player's Team (Optional)"
            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

        <SearchView
            android:id="@+id/playerTeamName_search_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_stat_chip"
            android:iconifiedByDefault="false"
            android:queryHint="Search or assign later in Teams" />

        <!-- Player Email -->
        <TextView
            android:id="@+id/playerEmail_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Player E-Mail"
            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

        <EditText
            android:id="@+id/playerEmail_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:autofillHints="emailAddress"
            android:hapticFeedbackEnabled="true"
            android:hint="player@example.com"
            android:inputType="textEmailAddress"
            android:lines="1"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <!-- Player Roles & Styles -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Playing Roles (select at least one) *"
            android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stat_chip"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <CheckBox
                android:id="@+id/checkbox_batsmen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:onClick="onCheckBatsmen"
                android:text="Batsmen"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/batsmenStyle_radioGrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginLeft="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/radioBtn_RHBatsmen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="RHB (Right-Hand)" />

                <RadioButton
                    android:id="@+id/radioBtn_LHBatsmen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginLeft="20dp"
                    android:minHeight="48dp"
                    android:text="LHB (Left-Hand)" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/checkbox_bowler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:onClick="onCheckBowler"
                android:text="Bowler"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/bowlerStyle_radioGrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginLeft="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/radioBtn_RHBowler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="RHB (Right-Arm)" />

                <RadioButton
                    android:id="@+id/radioBtn_LHBowler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginLeft="20dp"
                    android:minHeight="48dp"
                    android:text="LHB (Left-Arm)" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/checkbox_wicketKeeper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:onClick="onCheckWK"
                android:text="Wicket-Keeper"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/playerDetails_save_btn"
            style="@style/Widget.Cricket.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:onClick="saveNewPlayer"
            android:text="Save Player" />

    </LinearLayout>
</ScrollView>
