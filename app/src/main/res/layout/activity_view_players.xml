<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Color_Background"
    android:fillViewport="true"
    tools:context="com.example.android.cricketscoreboard.views.ViewPlayers">

    <RelativeLayout
        android:id="@+id/activity_view_players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <!-- Player Selector Bar -->
        <LinearLayout
            android:id="@+id/playerSelectLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rectangle"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/playerNameSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <Button
                style="@style/Widget.Cricket.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:text="Save" />
        </LinearLayout>

        <!-- Player Bio & Roles Card -->
        <RelativeLayout
            android:id="@+id/playerDetailsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/playerSelectLayout"
            android:layout_marginTop="12dp"
            android:background="@drawable/rectangle">

            <ImageView
                android:id="@+id/player_logo"
                android:layout_width="@dimen/avatar_size_md"
                android:layout_height="@dimen/avatar_size_md"
                android:layout_marginEnd="14dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/user_male_circle_2"
                android:contentDescription="Player avatar" />

            <TextView
                android:id="@+id/playerNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/player_logo"
                android:layout_toRightOf="@id/player_logo"
                android:hint="Player Name"
                android:textAppearance="@style/TextAppearance.Cricket.ScreenTitle" />

            <TextView
                android:id="@+id/playerEmailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/playerNameText"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@id/player_logo"
                android:layout_toRightOf="@id/player_logo"
                android:hint="Email"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/playerDOBText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/playerEmailText"
                android:layout_marginTop="2dp"
                android:layout_toEndOf="@id/player_logo"
                android:layout_toRightOf="@id/player_logo"
                android:hint="DOB"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/teamNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/playerDOBText"
                android:layout_marginTop="4dp"
                android:layout_toEndOf="@id/player_logo"
                android:layout_toRightOf="@id/player_logo"
                android:hint="Team Not Assigned"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/playerTeamNameSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/playerDOBText"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@id/teamNameText"
                android:layout_toRightOf="@id/teamNameText" />

            <!-- Role Checkboxes & Stats Switcher -->
            <RelativeLayout
                android:id="@+id/playerProfileLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/player_logo"
                android:layout_marginTop="14dp">

                <CheckBox
                    android:id="@+id/checkbox_batsmen_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Batsmen"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/batsmenStyle_radioGrp_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/checkbox_batsmen_edit"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_toEndOf="@id/checkbox_batsmen_edit"
                    android:layout_toRightOf="@id/checkbox_batsmen_edit"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <RadioButton
                        android:id="@+id/radioBtn_RHBatsmen_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="RHB" />

                    <RadioButton
                        android:id="@+id/radioBtn_LHBatsmen_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:minHeight="48dp"
                        android:text="LHB" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/checkbox_bowler_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/checkbox_batsmen_edit"
                    android:minHeight="48dp"
                    android:text="Bowler"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/bowlerStyle_radioGrp_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/checkbox_bowler_edit"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_toEndOf="@id/checkbox_bowler_edit"
                    android:layout_toRightOf="@id/checkbox_bowler_edit"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <RadioButton
                        android:id="@+id/radioBtn_RHBowler_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="RHB" />

                    <RadioButton
                        android:id="@+id/radioBtn_LHBowler_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:minHeight="48dp"
                        android:text="LHB" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/checkbox_wicketKeeper_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/checkbox_bowler_edit"
                    android:minHeight="48dp"
                    android:text="Wicket-Keeper"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/playerStatsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/checkbox_wicketKeeper_edit"
                    android:layout_marginTop="12dp"
                    android:text="Player Career Statistics"
                    android:textAppearance="@style/TextAppearance.Cricket.SectionTitle" />

                <RadioGroup
                    android:id="@+id/playerStats_radioGrp_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/playerStatsTextView"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <RadioButton
                        android:id="@+id/radioBtn_Batsmen_edit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="Batsmen" />

                    <RadioButton
                        android:id="@+id/radioBtn_Bowler_edit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="Bowler" />
                </RadioGroup>
            </RelativeLayout>

            <!-- Career Statistics Tables -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/playerProfileLayout"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_stat_chip">

                <ScrollView
                    android:id="@+id/player_details_Batsmen_Table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="0,1,2">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Batting Summary"
                            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

                        <TableRow>
                            <TextView
                                android:gravity="center"
                                android:text="Matches"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="Total Runs"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="Balls Faced"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />
                        </TableRow>

                        <TableRow android:paddingBottom="10dp">
                            <TextView
                                android:id="@+id/playerTeamMatchPlayedValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerTeamTotalRun"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerTeamTotalBalls"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:gravity="center"
                                android:text="50s"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="100s"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="200s"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:id="@+id/playerTeamFifty"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerTeamHundred"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerTeamTwoHundred"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />
                        </TableRow>
                    </TableLayout>
                </ScrollView>

                <ScrollView
                    android:id="@+id/player_details_Bowler_Table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="invisible">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="0,1,2">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Bowling Summary"
                            android:textAppearance="@style/TextAppearance.Cricket.FieldLabel" />

                        <TableRow>
                            <TextView
                                android:gravity="center"
                                android:text="Matches"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="Wickets"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="Balls"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />
                        </TableRow>

                        <TableRow android:paddingBottom="10dp">
                            <TextView
                                android:id="@+id/playerMatchPlayedValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerWicketsValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerBallsFacedValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:gravity="center"
                                android:text="Economy"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="Wides"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />

                            <TextView
                                android:gravity="center"
                                android:text="No Balls"
                                android:textAppearance="@style/TextAppearance.Cricket.StatLabel" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:id="@+id/bowlerEconomyValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerWidesValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />

                            <TextView
                                android:id="@+id/playerNoBallValue"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="@style/TextAppearance.Cricket.StatValue" />
                        </TableRow>
                    </TableLayout>
                </ScrollView>
            </RelativeLayout>

        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
