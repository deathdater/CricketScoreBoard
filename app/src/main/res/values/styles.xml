<resources>

    <!-- Base application theme (MaterialComponents DayNight with DarkActionBar). -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:colorBackground">@color/Color_Background</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>

    <!-- Accent Palette Overlays (applied dynamically via UiPreferences) -->
    <style name="ThemeOverlay.Cricket.Accent.TurfGreen" parent="">
        <item name="colorPrimary">@color/accent_turf_primary</item>
        <item name="colorPrimaryDark">@color/accent_turf_dark</item>
        <item name="colorPrimaryVariant">@color/accent_turf_primary</item>
        <item name="colorAccent">@color/accent_turf_secondary</item>
        <item name="colorSecondary">@color/accent_turf_secondary</item>
    </style>

    <style name="ThemeOverlay.Cricket.Accent.StadiumBlue" parent="">
        <item name="colorPrimary">@color/accent_stadium_primary</item>
        <item name="colorPrimaryDark">@color/accent_stadium_dark</item>
        <item name="colorPrimaryVariant">@color/accent_stadium_primary</item>
        <item name="colorAccent">@color/accent_stadium_secondary</item>
        <item name="colorSecondary">@color/accent_stadium_secondary</item>
    </style>

    <style name="ThemeOverlay.Cricket.Accent.PavilionGold" parent="">
        <item name="colorPrimary">@color/accent_pavilion_primary</item>
        <item name="colorPrimaryDark">@color/accent_pavilion_dark</item>
        <item name="colorPrimaryVariant">@color/accent_pavilion_primary</item>
        <item name="colorAccent">@color/accent_pavilion_secondary</item>
        <item name="colorSecondary">@color/accent_pavilion_secondary</item>
    </style>

    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
        <item name="metaButtonBarButtonStyle">?android:attr/buttonBarButtonStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="AppTheme">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:colorBackground">@color/Color_Background</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Design System Typography Styles -->
    <style name="TextAppearance.Cricket.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Cricket.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Cricket.FieldLabel" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Cricket.StatValue" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Cricket.StatLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Reusable Button & Dashboard Tile Styles -->
    <style name="Widget.Cricket.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="Widget.Cricket.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/colorOutline</item>
    </style>

    <style name="Widget.Cricket.DashboardTile" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">96dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/card_corner_radius</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">@color/colorPrimaryContainer</item>
    </style>

</resources>
